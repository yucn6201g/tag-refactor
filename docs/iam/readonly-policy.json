{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TagRefactorReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "tag:GetResources",
        "iam:GetAccountAuthorizationDetails",
        "config:DescribeConfigurationRecorders",
        "config:DescribeConfigurationRecorderStatus",
        "config:SelectResourceConfig",
        "resource-explorer-2:ListIndexes",
        "resource-explorer-2:GetDefaultView",
        "resource-explorer-2:GetView",
        "resource-explorer-2:Search",
        "s3:ListAllMyBuckets",
        "kms:ListKeys",
        "sqs:ListQueues",
        "sns:ListTopics",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TagRefactorReadBucketPolicies",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPolicy",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::*"
    },
    {
      "Sid": "TagRefactorReadKeyPolicies",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy"
      ],
      "Resource": "arn:aws:kms:*:<account-id>:key/*"
    },
    {
      "Sid": "TagRefactorReadQueuePolicies",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:*:<account-id>:*"
    },
    {
      "Sid": "TagRefactorReadTopicPolicies",
      "Effect": "Allow",
      "Action": [
        "sns:GetTopicAttributes"
      ],
      "Resource": "arn:aws:sns:*:<account-id>:*"
    },
    {
      "Sid": "TagRefactorReadSecretPolicies",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetResourcePolicy"
      ],
      "Resource": "arn:aws:secretsmanager:*:<account-id>:secret:*"
    }
  ]
}
